# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Docker Compose builds DATABASE_URL for the app itself from POSTGRES_PASSWORD (set it before the
# first `docker compose up`: Postgres keeps the password it was initialised with). DATABASE_URL here is for
# running without Docker (uv run ...).
POSTGRES_PASSWORD=cqa
DATABASE_URL=postgresql://cqa:cqa@localhost:5432/cqa
# Tests create and drop their own schema on this server.
# TEST_DATABASE_URL=postgresql://cqa:cqa@localhost:5432/cqa

# Organizers' API. Paste the DEV button link and replace the group id with {group_id}:
#   DATASET_API_URL=https://<host>/<path>?group_id={group_id}
# Empty = offline mode: group "SAMPLE" loads data/fixtures/SAMPLE.json.
DATASET_API_URL=
# team_name in results/{dev,prod}/results.json (cqa.cli export)
CQA_TEAM_NAME=Dreamers

# mock = no API key needed, deterministic fake answers (for UI/engine dev).
# openai = real models.
LLM_PROVIDER=mock
OPENAI_API_KEY=
# For api.openai.com leave OPENAI_BASE_URL out entirely: an empty value is read by the SDK as the address.
# Any OpenAI-compatible server (vLLM, SGLang): set the base URL, any non-empty key, the served model name
# in MODEL_*, and turn Qwen thinking off:
#   OPENAI_BASE_URL=https://<host>/v1
#   OPENAI_API_KEY=none
#   LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Three roles, one provider. Model comparison on the bench: docs/EVALUATION.md §5.4-5.6 (production: terra + precedents).
MODEL_INSPECTOR=gpt-6.1-terra
MODEL_ADVOCATE=gpt-6.1-terra
MODEL_JUDGE=gpt-6.1-terra
# Reasoning models (gpt-5*, gpt-6*): minimal | none | low | medium | high. gpt-6.1-sol needs low or above.
REASONING_EFFORT=low

# always = the judge rules on every criterion; disputed = only where M1 and M2 disagree (cheaper).
JUDGE_MODE=disputed
# panel | precedents (similar decided cases in the prompt, docs/EVALUATION.md §5.5)
CQA_APPROACH=precedents
# Requests per minute cap for a proxy with a per-key limit (0 = none)
LLM_RPM=0
# Precedent pool splits and embedding model (text-embedding-3-small on OpenAI, BAAI/bge-m3 on an open-model proxy)
PRECEDENT_SPLITS=tune,holdout,fresh
PRECEDENT_EMBED_MODEL=text-embedding-3-small
# results.json model.mode override: local | external_api | hybrid (empty = guessed)
CQA_MODEL_MODE=
# Share of the three roles that must agree with the final verdict to auto-accept. Calibrate on the gold set.
TRUST_THRESHOLD=0.67
# Max parallel LLM calls.
CONCURRENCY=8
RATIONALE_LANGUAGE=Russian

# USD per 1M tokens [input, output], used for "$ per evaluation". Check the provider's pricing page.
LLM_PRICES={"gpt-6.1-terra": [1, 5], "gpt-6.1-sol": [2, 10], "gpt-6-luna": [0.1, 0.5], "text-embedding-3-small": [0.02, 0]}
